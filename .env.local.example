# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Date du premier jour de l'événement (J1), format YYYY-MM-DD
NEXT_PUBLIC_EVENT_START_DATE=2026-09-08

# === QR ===
# Rotation visuelle du QR à l'écran.
QR_ROTATION_SECONDS=5
# Durée de validité d'un token = TTL + grâce (doit couvrir la saisie du CNE).
QR_TTL_SECONDS=120
QR_GRACE_SECONDS=30

# Mot de passe de l'écran QR public (/ecran). Chaîne longue et aléatoire.
# Obligatoire pour que /ecran fonctionne. L'écran connecté (menu) n'en a pas besoin.
SCREEN_KEY=change-moi-pour-une-longue-chaine-aleatoire
